# Copy to .env and fill in. Never commit .env.

# --- Core (required) ---
# Local: docker compose up -d postgres  (or any Postgres 16). Production: Neon connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/partsyaar
# Long random string: `openssl rand -hex 32`
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public URL of the site (used for links in emails, sitemap, OG tags)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Media storage (optional locally; required on Vercel) ---
# Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region "auto".
# AWS S3: leave S3_ENDPOINT empty and set S3_REGION (e.g. ap-south-1).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (Phase 3) ---
# Without a key, emails are printed to the server log instead of being sent.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=orders@partsyaar.com
EMAIL_FROM_NAME=Partsyaar.com

# --- Seed (first owner account created by `pnpm seed`) ---
SEED_OWNER_EMAIL=owner@partsyaar.com
SEED_OWNER_PASSWORD=change-me
